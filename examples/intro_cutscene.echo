// Reimplements the waypoint list from
// src/ServerScriptService/07_NarrativeCutscenes.server.lua as an EchoScript,
// driven entirely through a host API of moveCamera/say/wait calls.
//
// The Lua version hardcodes a `waypoints` table of {cf, time, speaker, text}.
// Here the sequence is just... the script. A designer can add a beat,
// branch on a flag, or loop a line without touching any Lua.

fn beat(dx, dy, dz, holdSeconds, line) {
	moveCamera(dx, dy, dz, holdSeconds)
	if len(line) > 0 {
		say(line)
	}
	wait(holdSeconds)
}

say("The Fracture awakens.")

beat(0, 25, 0, 3, "The Fracture: a memory that broke instead of fading.")
beat(20, 8, 20, 3, "You are a Warden of Echoes. You can record your own actions...")
beat(-15, 6, 10, 3, "...and leave them behind as loops of light, to hold what you cannot hold alone.")

// A shard-count-driven branch a hardcoded waypoint table couldn't express
// without a rewrite:
let shardsFound = 0
if shardsFound == 0 {
	say("Find the Color Shards. The world remembers what you restore.")
} else {
	say("Welcome back, Warden.")
}
